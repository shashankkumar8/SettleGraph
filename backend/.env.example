# Copy values into your backend process environment. Do not commit real API keys.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_ASR_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=shubh_enhi_ads
# Optional: local SQLite file path. Defaults to backend/settlegraph.db.
# SETTLEGRAPH_DB=./settlegraph.db

# Explicit browser origins allowed to call this API. Never use * for a deployed app.
SETTLEGRAPH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
